def plot_training_history(history, save_path='training_curve.png'):
    """Visualize training loss curves"""
    print(f"\n=== Generating training curve ===")
    
    train_losses = history['train_loss']
    val_losses = history.get('val_loss', None)
    epochs = range(1, len(train_losses) + 1)
    
    plt.figure(figsize=(12, 6))
    plt.plot(epochs, train_losses, 'b-', linewidth=2, label='Training Loss', alpha=0.8)
    
    if val_losses and len(val_losses) > 0:
        plt.plot(epochs, val_losses, 'r-', linewidth=2, label='Validation Loss', alpha=0.8)
        
        best_epoch = np.argmin(val_losses) + 1
        best_val_loss = min(val_losses)
        plt.scatter([best_epoch], [best_val_loss], color='red', s=100, 
                   zorder=5, label=f'Best Val Loss: {best_val_loss:.6f} (Epoch {best_epoch})')
        plt.axvline(x=best_epoch, color='red', linestyle='--', alpha=0.3)
    
    plt.xlabel('Epoch', fontsize=12, fontweight='bold')
    plt.ylabel('Loss', fontsize=12, fontweight='bold')
    plt.title('Training and Validation Loss Over Epochs', fontsize=14, fontweight='bold')
    plt.legend(loc='upper right', fontsize=10)
    plt.grid(True, alpha=0.3, linestyle='--')
    
    min_loss = min(train_losses)
    if val_losses:
        min_loss = min(min_loss, min(val_losses))
    if min_loss > 0:
        plt.ylim(bottom=0)
    
    textstr = f'Final Train Loss: {train_losses[-1]:.6f}\n'
    if val_losses and len(val_losses) > 0:
        textstr += f'Final Val Loss: {val_losses[-1]:.6f}\n'
        textstr += f'Best Val Loss: {best_val_loss:.6f}'
    
    props = dict(boxstyle='round', facecolor='wheat', alpha=0.5)
    plt.text(0.02, 0.98, textstr, transform=plt.gca().transAxes, 
             fontsize=10, verticalalignment='top', bbox=props)
    
    plt.tight_layout()
    plt.savefig(save_path, dpi=300, bbox_inches='tight')
    print(f"✅ Training curve saved to: {save_path}")
    plt.show()
    plt.close()
    
    print(f"\nTraining statistics:")
    print(f"  Total epochs: {len(train_losses)}")
    print(f"  Final train loss: {train_losses[-1]:.6f}")
    if val_losses and len(val_losses) > 0:
        print(f"  Final val loss: {val_losses[-1]:.6f}")
        print(f"  Best val loss: {best_val_loss:.6f} (Epoch {best_epoch})")

def train_anomaly_detection_model(train_scaffolds, val_scaffolds=None, 
                                num_epochs=100, batch_size=32, 
                                learning_rate=0.0001, device='cuda',
                                cnn_doubt_percentile=85,     
                                cnn_anomaly_percentile=90):
    """Train anomaly detection model based on reconstruction error"""
    print("\n=== Starting anomaly detection model training ===")
    
    CNN_DOUBT_PERCENTILE = cnn_doubt_percentile     
    CNN_ANOMALY_PERCENTILE = cnn_anomaly_percentile  
    
    # Prepare training data
    train_sequences, train_names = prepare_complete_scaffolds(train_scaffolds)
    train_sequences = np.array(train_sequences)
    
    # Data standardization
    scaler = StandardScaler()
    train_sequences_scaled = scaler.fit_transform(train_sequences)
    
    X_train = torch.FloatTensor(train_sequences_scaled).unsqueeze(1)
    
    train_dataset = TensorDataset(X_train)
    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)
    
    # Prepare validation set
    val_loader = None
    if val_scaffolds is not None:
        val_sequences, val_names = prepare_complete_scaffolds(val_scaffolds)
        val_sequences_scaled = scaler.transform(val_sequences)
        X_val = torch.FloatTensor(val_sequences_scaled).unsqueeze(1)
        val_dataset = TensorDataset(X_val)
        val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)
    
    # Initialize model
    model = ScaffoldAutoencoder().to(device)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, patience=10, factor=0.5)
    
    history = {
        'train_loss': [],
        'val_loss': [],
        'reconstruction_errors': []
    }
    
    best_val_loss = float('inf')
    
    # Training loop
    for epoch in range(num_epochs):
        # Training phase
        model.train()
        train_loss = 0.0
        
        for batch_data in train_loader:
            batch_x = batch_data[0].to(device)
            
            optimizer.zero_grad()
            reconstructed, features = model(batch_x)
            loss = criterion(reconstructed, batch_x.squeeze(1))
            loss.backward()
            optimizer.step()
            
            train_loss += loss.item() * batch_x.size(0)
        
        avg_train_loss = train_loss / len(train_dataset)
        history['train_loss'].append(avg_train_loss)
        
        # Validation phase
        if val_loader is not None:
            model.eval()
            val_loss = 0.0
            val_reconstruction_errors = []
            
            with torch.no_grad():
                for batch_data in val_loader:
                    batch_x = batch_data[0].to(device)
                    reconstructed, features = model(batch_x)
                    
                    batch_errors = torch.mean((reconstructed - batch_x.squeeze(1)) ** 2, dim=1)
                    val_reconstruction_errors.extend(batch_errors.cpu().numpy())
                    
                    loss = criterion(reconstructed, batch_x.squeeze(1))
                    val_loss += loss.item() * batch_x.size(0)
            
            avg_val_loss = val_loss / len(val_dataset)
            history['val_loss'].append(avg_val_loss)
            history['reconstruction_errors'].append(val_reconstruction_errors)
            
            scheduler.step(avg_val_loss)
            
            # Save best model
            if avg_val_loss < best_val_loss:
                best_val_loss = avg_val_loss
                torch.save({
                    'model_state_dict': model.state_dict(),
                    'scaler': scaler,
                    'epoch': epoch,
                    'best_val_loss': best_val_loss
                }, 'best_anomaly_model.pth')
            
            if (epoch + 1) % 10 == 0:
                print(f'Epoch [{epoch+1}/{num_epochs}], '
                      f'Train Loss: {avg_train_loss:.6f}, '
                      f'Val Loss: {avg_val_loss:.6f}')
        else:
            if (epoch + 1) % 10 == 0:
                print(f'Epoch [{epoch+1}/{num_epochs}], Train Loss: {avg_train_loss:.6f}')
                
    print("\n=== Computing validation set thresholds ===")
    model.eval()
    
    # Compute error distribution on entire validation set
    val_reconstruction_errors = []
    with torch.no_grad():
        for batch_data in val_loader:
            batch_x = batch_data[0].to(device)
            reconstructed, _ = model(batch_x)
            errors = torch.mean((reconstructed - batch_x.squeeze(1)) ** 2, dim=1)
            val_reconstruction_errors.extend(errors.cpu().numpy())
    
    val_errors = np.array(val_reconstruction_errors)
    
    thresholds = {
        'doubt': np.percentile(val_errors, CNN_DOUBT_PERCENTILE),
        'anomaly': np.percentile(val_errors, CNN_ANOMALY_PERCENTILE),
        'mean': np.mean(val_errors),
        'std': np.std(val_errors),
        'doubt_percentile': CNN_DOUBT_PERCENTILE, 
        'anomaly_percentile': CNN_ANOMALY_PERCENTILE
    }
    
    print(f"Based on validation set ({len(val_errors)} samples):")
    print(f"  Doubt threshold ({CNN_DOUBT_PERCENTILE}%):   {thresholds['doubt']:.6f}")
    print(f"  Anomaly threshold ({CNN_ANOMALY_PERCENTILE}%): {thresholds['anomaly']:.6f}")

    # Save final model
    torch.save({
        'model_state_dict': model.state_dict(),
        'scaler': scaler,
        'history': history,
        'thresholds': thresholds
    }, 'best_anomaly_model.pth')
    
    plot_training_history(history, save_path='training_curve.png')
    print("\n✅ Model training completed")
    
    return model, scaler, history

