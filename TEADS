def visualize_classification_results(scaffolds, results, max_plots=5000):
    """Visualize classification results by category"""
    print(f"\n=== Visualizing classification results ===")
    
    anomaly_indices = [i for i, status in enumerate(results['final_statuses']) if status == 'anomaly']
    doubt_indices = [i for i, status in enumerate(results['final_statuses']) if status == 'doubt']
    
    if len(anomaly_indices) == 0 and len(doubt_indices) == 0:
        print("✅ All scaffolds are normal")
        return
    
    # Prioritize anomalies, then doubts
    display_indices = anomaly_indices[:max_plots]
    if len(display_indices) < max_plots:
        remaining_slots = max_plots - len(display_indices)
        display_indices.extend(doubt_indices[:remaining_slots])
    
    display_count = min(max_plots, len(display_indices))
    if display_count == 0:
        return

    print(f"Displaying {display_count} non-normal scaffolds")
    
    cols = min(3, display_count)
    rows = (display_count + cols - 1) // cols
    
    fig, axes = plt.subplots(rows, cols, figsize=(6*cols, 4*rows))
    if display_count == 1:
        axes = [axes]
    elif rows == 1:
        axes = axes if isinstance(axes, np.ndarray) else [axes]
    else:
        axes = axes.flatten()
    
    for i in range(display_count):
        idx = display_indices[i]
        scaffold_name = results['scaffold_names'][idx]
        
        if scaffold_name not in scaffolds:
            continue
            
        data = scaffolds[scaffold_name]
        positions = data['positions'] / 1000000  # Convert to Mb
        
        ax = axes[i]
        
        # Plot TE composition
        ax.plot(positions, data['ltr'], 'b-', label='LTR', linewidth=2, alpha=0.7)
        ax.plot(positions, data['line'], 'r-', label='LINE', linewidth=2, alpha=0.7)
        ax.plot(positions, data['sine'], 'g-', label='SINE', linewidth=2, alpha=0.7)
        ax.plot(positions, data['dna'], 'm-', label='DNA', linewidth=2, alpha=0.7)
        ax.plot(positions, data['unknown'], 'c-', label='Unknown', linewidth=2, alpha=0.7)
        ax.plot(positions, data['values'], 'k-', label='Total_TE', linewidth=3)
        
        final_status = results['final_statuses'][idx]
        reason = results['reasons'][idx]
        cnn_score = results['cnn_scores'][idx]
        pattern_score = results['pattern_scores'][idx]
        
        status_color = {'anomaly': 'red', 'doubt': 'orange', 'normal': 'green'}.get(final_status, 'black')
        
        title = f"{scaffold_name} ({final_status.upper()})\n{reason}\nCNN:{cnn_score:.3f}, Pattern:{pattern_score:.3f}"
        ax.set_title(title, fontsize=9, color=status_color, weight='bold' if final_status == 'anomaly' else 'normal')
        ax.set_xlabel('Genomic position (Mb)', fontsize=9)
        ax.set_ylabel('TE density', fontsize=9)
        ax.legend(fontsize=7)
        ax.grid(True, alpha=0.3)
    
    # Hide extra subplots
    for i in range(display_count, len(axes)):
        axes[i].set_visible(False)
    
    plt.tight_layout()
    output_dir = './anomaly_plots'
    os.makedirs(output_dir, exist_ok=True)
    output_path = os.path.join(output_dir, f'anomaly_all_scaffolds.pdf') 
    plt.savefig(output_path, dpi=500, bbox_inches='tight')
    plt.close()
    print(f"✓ 图片已保存: {output_path}")
    return display_indices

def save_results(results, scaffolds, output_dir="results"):
    """Save detection results"""
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
    
    results_df = pd.DataFrame({
        'Scaffold': results['scaffold_names'],
        'CNN_Score': results['cnn_scores'],
        'Pattern_Score': results['pattern_scores'],
        'Pattern_Type': results['pattern_types'],
        'Pattern_Status': results['pattern_statuses'],
        'CNN_Status': results['cnn_statuses'],
        'Has_Outliers': results.get('outlier_flags', [False] * len(results['scaffold_names'])),
        'Final_Status': results['final_statuses'],
        'Reason': results['reasons'],
    })
    
    # Add source file info
    source_files = []
    for name in results['scaffold_names']:
        if name in scaffolds:
            source_files.append(scaffolds[name].get('source_file', 'unknown'))
        else:
            source_files.append('unknown')
    results_df['Source_File'] = source_files
    
    # Save complete results
    results_path = os.path.join(output_dir, "te_anomaly_results.csv")
    results_df.to_csv(results_path, index=False)
    print(f"✅ Complete results saved to: {results_path}")
    
    # Save anomalous scaffolds
    anomalies = results_df[results_df['Final_Status'] == 'anomaly']
    if len(anomalies) > 0:
        anomaly_path = os.path.join(output_dir, "anomalous_scaffolds.csv")
        anomalies.to_csv(anomaly_path, index=False)
        print(f"✅ Anomalous scaffolds saved to: {anomaly_path} ({len(anomalies)} scaffolds)")
    
    return results_path, results_df

