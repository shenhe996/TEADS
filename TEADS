def detect_anomalies(scaffolds, model_path='best_anomaly_model.pth', device='cuda'):
    """Detect anomalies using trained model"""
    print("\n=== Anomaly detection ===")
    
    if not os.path.exists(model_path):
        raise FileNotFoundError(f"Model file {model_path} not found. Train model first.")

    # Load model and scaler
    checkpoint = torch.load(model_path, map_location=device, weights_only=False)
    model = ScaffoldAutoencoder().to(device)
    model.load_state_dict(checkpoint['model_state_dict'])
    model.eval()
    scaler = checkpoint['scaler']
    
    saved_thresholds = checkpoint.get('thresholds', None)
    
    if saved_thresholds:
        print(f"✅ Using saved thresholds from training")
    else:
        print("⚠️ Warning: No threshold information in model file")
    
    # Prepare data
    sequences, names = prepare_complete_scaffolds(scaffolds)
    sequences_scaled = scaler.transform(sequences)
    X = torch.FloatTensor(sequences_scaled).unsqueeze(1)
    
    # Compute reconstruction errors in batches
    batch_size = 32
    reconstruction_errors = []
    features_list = []
    
    with torch.no_grad():
        for i in range(0, len(X), batch_size):
            batch = X[i:i+batch_size].to(device)
            reconstructed, features = model(batch)
            
            errors = torch.mean((reconstructed - batch.squeeze(1)) ** 2, dim=1)
            reconstruction_errors.extend(errors.cpu().numpy())
            features_list.append(features.cpu().numpy())
    
    reconstruction_errors = np.array(reconstruction_errors)
    all_features = np.vstack(features_list)
    
    results = {
        'scaffold_names': names,
        'anomaly_scores': reconstruction_errors,
        'features': all_features,
        'saved_thresholds': saved_thresholds  
    }
    
    return results

def detect_te_distribution_pattern(scaffold_data):
    """Simplified TE distribution pattern detection"""
    values = scaffold_data['values']
    length = len(values)
    quarter_size = length // 4

    first_quarter = np.mean(values[:quarter_size])
    second_quarter = np.mean(values[quarter_size:2*quarter_size])
    third_quarter = np.mean(values[2*quarter_size:3*quarter_size])
    fourth_quarter = np.mean(values[3*quarter_size:])
    
    ends_mean = (first_quarter + fourth_quarter) / 2
    middle_mean = (second_quarter + third_quarter) / 2

    pattern_info = {
        'quarters_mean': [first_quarter, second_quarter, third_quarter, fourth_quarter],
        'ends_mean': ends_mean,
        'middle_mean': middle_mean
    }

    # Anomaly detection: ends higher than middle (valley pattern)
    if ends_mean > middle_mean:
        difference_ratio = (ends_mean - middle_mean) / (middle_mean + 1e-8)
        pattern_info['difference_ratio'] = difference_ratio
        
        if difference_ratio > 0.1:
            pattern_info['anomaly_confidence'] = min(difference_ratio, 1.0)
            return 'valley_pattern_anomaly', pattern_info
        else:
            return 'borderline_normal', pattern_info
    else:
        # Normal pattern: middle higher than ends (peak pattern)
        difference_ratio = (middle_mean - ends_mean) / (ends_mean + 1e-8)
        pattern_info['difference_ratio'] = difference_ratio
        
        if difference_ratio > 0.2:
            return 'normal_peak_pattern', pattern_info
        else:
            return 'flat_or_unclear', pattern_info

def calculate_pattern_based_anomaly_score(pattern_type, pattern_info):
    """Calculate anomaly score based on pattern type (0=normal, 1=anomaly)"""
    if pattern_type == 'valley_pattern_anomaly':
        base_score = 0.7
        confidence = pattern_info.get('anomaly_confidence', 0)
        return min(base_score + confidence * 0.3, 1.0)
    elif pattern_type == 'borderline_normal':
        return 0.4
    elif pattern_type == 'normal_peak_pattern':
        return 0.0
    elif pattern_type == 'flat_or_unclear':
        return 0.2
    else:
        return 0.5

def run_outlier_detection_on_processed_scaffolds(scaffolds, z_threshold=4.5):
    """Outlier detection on preprocessed scaffolds"""
    print("\n=== Outlier detection on preprocessed scaffolds ===")
    
    outlier_results = {}
    all_outliers_data = []
    
    for scaffold_name, scaffold_data in scaffolds.items():
        te_values = scaffold_data['values']
        positions = scaffold_data['positions']
        
        if len(te_values) < 2:
            outlier_results[scaffold_name] = {
                'has_outliers': False,
                'outlier_count': 0,
                'outlier_positions': []
            }
            continue
        
        # Compute delta TE between adjacent windows
        delta_te_values = []
        delta_positions = []
        
        for i in range(len(te_values) - 1):
            delta_te = te_values[i] - te_values[i + 1]
            delta_position = (positions[i] + positions[i + 1]) / 2
            delta_te_values.append(delta_te)
            delta_positions.append(delta_position)
        
        if len(delta_te_values) == 0:
            outlier_results[scaffold_name] = {
                'has_outliers': False,
                'outlier_count': 0,
                'outlier_positions': []
            }
            continue
        
        # Compute Z-score
        delta_te_array = np.array(delta_te_values)
        mean_delta_te = np.mean(delta_te_array)
        std_delta_te = np.std(delta_te_array)
        
        if std_delta_te == 0:
            outlier_results[scaffold_name] = {
                'has_outliers': False,
                'outlier_count': 0,
                'outlier_positions': []
            }
            continue
        
        z_scores = (delta_te_array - mean_delta_te) / std_delta_te
        
        # Detect outliers (|Z| > threshold)
        outlier_mask = np.abs(z_scores) > z_threshold
        outlier_indices = np.where(outlier_mask)[0]
        
        if len(outlier_indices) > 0:
            outlier_positions = [delta_positions[i] for i in outlier_indices]
            max_z_score = np.max(np.abs(z_scores[outlier_mask]))
            
            outlier_results[scaffold_name] = {
                'has_outliers': True,
                'outlier_count': len(outlier_indices),
                'outlier_positions': outlier_positions,
                'max_z_score': max_z_score
            }
            
            # Save detailed outlier data
            for i, idx in enumerate(outlier_indices):
                all_outliers_data.append({
                    'Scaffold': scaffold_name,
                    'LocalPosition': delta_positions[idx],
                    'DeltaTE': delta_te_values[idx],
                    'Z_score': z_scores[idx],
                    'WindowIndex': idx
                })
        else:
            outlier_results[scaffold_name] = {
                'has_outliers': False,
                'outlier_count': 0,
                'outlier_positions': []
            }
    
    # Create outliers DataFrame
    outliers_df = pd.DataFrame(all_outliers_data)
    
    # Overall statistics
    total_scaffolds = len(scaffolds)
    has_outliers_count = sum(1 for result in outlier_results.values() if result['has_outliers'])
    total_outliers = len(outliers_df)
    
    print(f"\n=== Outlier detection completed ===")
    print(f"Scaffolds checked: {total_scaffolds}")
    print(f"Anomalous scaffolds (with outliers): {has_outliers_count}")
    print(f"Normal scaffolds (no outliers): {total_scaffolds - has_outliers_count}")
    print(f"Total outliers: {total_outliers}")
    
    if total_outliers > 0:
        print("\nAnomalous scaffold list:")
        for name, result in outlier_results.items():
            if result['has_outliers']:
                print(f"  ❌ {name}: {result['outlier_count']} outliers (max |Z|: {result['max_z_score']:.3f})")
    
    return outlier_results, outliers_df

def combine_anomaly_detection_fixed(scaffolds, test_df, cnn_model_path='best_anomaly_model.pth', 
                                   device='cuda', z_threshold=4.5):
    """Combined anomaly detection using multiple methods"""
    
    # Run outlier detection
    outlier_results, outliers_df = run_outlier_detection_on_processed_scaffolds(
        scaffolds, z_threshold=z_threshold
    )
    
    # Run CNN detection
    cnn_results = detect_anomalies(scaffolds, cnn_model_path, device=device)
    
    cnn_scores_raw = cnn_results['anomaly_scores']
    pattern_results = {}
    
    # Initialize result lists
    scaffold_names = cnn_results['scaffold_names']
    pattern_scores = []
    pattern_types = []
    outlier_flags = []
    pattern_statuses = []
    cnn_statuses = []
    final_statuses = []
    reasons = []
    
    # Pattern detection for each scaffold
    for name in scaffold_names:
        scaffold_data = scaffolds[name]
        
        outlier_info = outlier_results.get(name, {
            'has_outliers': False,
            'outlier_count': 0,
            'max_z_score': 0,
            'outlier_positions': []
        })
        
        pattern_type, pattern_info = detect_te_distribution_pattern(scaffold_data)
        pattern_score = calculate_pattern_based_anomaly_score(pattern_type, pattern_info)
        has_outliers = outlier_info.get('has_outliers', False)
        
        pattern_results[name] = {
            'pattern_type': pattern_type,
            'pattern_info': pattern_info,
            'pattern_score': pattern_score,
            'has_outliers': has_outliers,
            'outlier_info': outlier_info
        }
        pattern_scores.append(pattern_score)
        pattern_types.append(pattern_type)
        outlier_flags.append(has_outliers)
    
    # Get thresholds
    if 'saved_thresholds' in cnn_results and cnn_results['saved_thresholds']:
        thresholds = cnn_results['saved_thresholds']
        cnn_threshold_doubt = thresholds['doubt']
        cnn_threshold_anomaly = thresholds['anomaly']
        
        doubt_pct = thresholds.get('doubt_percentile', 85)
        anomaly_pct = thresholds.get('anomaly_percentile', 90)
        
        print(f"✅ Using saved thresholds from training:")
        print(f"  Doubt ({doubt_pct}%): {cnn_threshold_doubt:.6f}")
        print(f"  Anomaly ({anomaly_pct}%): {cnn_threshold_anomaly:.6f}")
    else:
        print("⚠️ Warning: No saved thresholds, computing from test set")
        cnn_threshold_doubt = np.percentile(cnn_scores_raw, 85)
        cnn_threshold_anomaly = np.percentile(cnn_scores_raw, 90)
        print(f"  Doubt: {cnn_threshold_doubt:.6f}")
        print(f"  Anomaly: {cnn_threshold_anomaly:.6f}")
    
    # Classification logic
    for i in range(len(scaffold_names)):
        scaffold_name = scaffold_names[i]
        cnn_score = cnn_scores_raw[i]
        pattern_score = pattern_scores[i]
        has_outliers = outlier_flags[i]
        outlier_count = pattern_results[scaffold_name]['outlier_info'].get('outlier_count', 0)
        
        pattern_status = 'normal'
        cnn_status = 'normal'
        final_status = 'normal'
        reason = 'Unknown'
        
        # Special rule: outliers => anomaly
        if has_outliers:
            pattern_status = 'anomaly'
            
            if cnn_score <= cnn_threshold_doubt:
                cnn_status = 'normal'
            elif cnn_score < cnn_threshold_anomaly:
                cnn_status = 'doubt'
            else:
                cnn_status = 'anomaly'
            
            final_status = 'anomaly'
            reason = f'Contains {outlier_count} delta-TE outliers'
        else:
            # Pattern classification
            if pattern_score <= 0.3:
                pattern_status = 'normal'
            elif pattern_score < 0.7:
                pattern_status = 'doubt'
            else:
                pattern_status = 'anomaly'
            
            # CNN classification
            if cnn_score <= cnn_threshold_doubt:
                cnn_status = 'normal'
            elif cnn_score < cnn_threshold_anomaly:
                cnn_status = 'doubt'
            else:
                cnn_status = 'anomaly'
            
            # Final combined judgment
            if pattern_status == 'anomaly' or cnn_status == 'anomaly':
                final_status = 'anomaly'
                if pattern_status == 'anomaly' and cnn_status == 'anomaly':
                    reason = 'Both pattern and CNN detected anomaly'
                elif pattern_status == 'anomaly':
                    reason = 'Pattern detected anomaly'
                else:
                    reason = 'CNN detected anomaly'
            elif pattern_status == 'doubt' or cnn_status == 'doubt':
                final_status = 'doubt'
                if pattern_status == 'doubt' and cnn_status == 'doubt':
                    reason = 'Both pattern and CNN doubtful'
                elif pattern_status == 'doubt':
                    reason = 'Pattern doubtful'
                else:
                    reason = 'CNN doubtful'
            else:
                final_status = 'normal'
                reason = 'Both pattern and CNN normal'
        
        pattern_statuses.append(pattern_status)
        cnn_statuses.append(cnn_status)
        final_statuses.append(final_status)
        reasons.append(reason)
    
    # Statistics
    num_anomaly = final_statuses.count('anomaly')
    num_doubt = final_statuses.count('doubt')
    num_normal = final_statuses.count('normal')
    num_outliers = sum(outlier_flags)
    total = len(scaffold_names)
    
    # Organize results
    results = {
        'scaffold_names': scaffold_names,
        'cnn_scores': cnn_scores_raw,
        'pattern_scores': pattern_scores,
        'pattern_types': pattern_types,
        'pattern_results': pattern_results,
        'pattern_statuses': pattern_statuses,
        'cnn_statuses': cnn_statuses,
        'final_statuses': final_statuses,
        'reasons': reasons,
        'outlier_flags': outlier_flags,
        'outlier_results': outlier_results,
        'outliers_df': outliers_df,
        'num_anomaly': num_anomaly,
        'num_doubt': num_doubt,
        'num_normal': num_normal,
        'num_outliers': num_outliers,
        'anomaly_rate': num_anomaly / total,
        'doubt_rate': num_doubt / total,
        'thresholds': {
            'cnn_doubt': cnn_threshold_doubt,
            'cnn_anomaly': cnn_threshold_anomaly,
            'pattern_doubt': 0.3,
            'pattern_anomaly': 0.7,
            'outlier_zscore': z_threshold
        }
    }
    
    # Output statistics
    print(f"\n=== Detection statistics ===")
    print(f"Total scaffolds: {total}")
    print(f"\nResults by method:")
    print(f"  CNN anomalies: {cnn_statuses.count('anomaly')} ({cnn_statuses.count('anomaly')/total:.2%})")
    print(f"  Pattern anomalies: {pattern_statuses.count('anomaly')} ({pattern_statuses.count('anomaly')/total:.2%})")
    print(f"  Outlier anomalies: {num_outliers} ({num_outliers/total:.2%})")
    
    print(f"\nFinal combined results:")
    print(f"  Anomalous: {num_anomaly} ({results['anomaly_rate']:.2%})")
    print(f"  Doubtful: {num_doubt} ({results['doubt_rate']:.2%})")
    print(f"  Normal: {num_normal} ({num_normal/total:.2%})")
    
    if num_outliers > 0:
        print(f"\n=== Outlier details ===")
        for name in scaffold_names:
            outlier_info = outlier_results.get(name, {})
            if outlier_info.get('has_outliers', False):
                print(f"  {name}:")
                print(f"    Outlier count: {outlier_info.get('outlier_count', 0)}")
                print(f"    Max Z-score: {outlier_info.get('max_z_score', 0):.3f}")
    
    return results

