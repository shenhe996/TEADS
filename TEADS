# Model Architecture
# =====================================================================

class ScaffoldCNN(nn.Module):
    """CNN encoder for scaffold sequences"""
    def __init__(self, pool_size=8):
        super().__init__()
        self.conv1d = nn.Conv1d(1, 64, kernel_size=8, stride=1, padding=4)
        self.conv2 = nn.Conv1d(64, 128, kernel_size=12, stride=2, padding=6)
        self.conv3 = nn.Conv1d(128, 256, kernel_size=8, stride=2, padding=4)
        self.global_pool = nn.AdaptiveAvgPool1d(pool_size)

    def forward(self, x):
        x = x.transpose(1, 2)
        x = x.permute(0, 2, 1)
        x = F.relu(self.conv1d(x))
        x = F.relu(self.conv2(x))
        x = F.relu(self.conv3(x))
        x = self.global_pool(x)
        x = torch.flatten(x, start_dim=1)
        return x

class ScaffoldAutoencoder(nn.Module):
    """Autoencoder for anomaly detection"""
    def __init__(self, pool_size=8):
        super().__init__()
        self.pool_size = pool_size
        self.encoder = ScaffoldCNN(pool_size=pool_size)
        
        latent_dim = 256 * pool_size
        self.decoder = nn.Sequential(
            nn.Linear(latent_dim, 1024),
            nn.ReLU(),
            nn.Linear(1024, 512),
            nn.ReLU(),
            nn.Linear(512, 100)
        )

    def forward(self, x):
        features = self.encoder(x)
        reconstructed = self.decoder(features)
        return reconstructed, features

    def encode(self, x):
        return self.encoder(x)

