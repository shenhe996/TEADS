def parse_arguments():
    """Parse command line arguments"""
    parser = argparse.ArgumentParser(
        description='TE Anomaly Detection System',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Usage examples:
  python TEADS --mode train --train-dir /path/to/data/
  python TEADS --mode test --test-dir /path/to/data/
        '''
    )
    
    # Mode selection
    parser.add_argument('--mode', type=str, choices=['train', 'test', 'both'],
                        help='Running mode')
    
    # File paths
    parser.add_argument('--train-dir', type=str, default=None,
                        help='Training data directory')
    parser.add_argument('--test-dir', type=str, default=None,
                        help='Testing data directory')
    
    # Training parameters
    parser.add_argument('--min-length', type=int, default=10000000,
                        help='Minimum scaffold length (bp), default: 10000000')
    parser.add_argument('--batch-size', type=int, default=16,
                        help='Batch size, default: 16')
    parser.add_argument('--epochs', type=int, default=100,
                        help='Number of epochs, default: 100')
    parser.add_argument('--lr', '--learning-rate', type=float, default=0.0001, dest='lr',
                        help='Learning rate, default: 0.0001')
    
    # Detection thresholds
    parser.add_argument('--z-threshold', type=float, default=4.5,
                        help='Z-score threshold for outlier detection, default: 4.5')
    parser.add_argument('--cnn-doubt-percentile', type=float, default=85,
                        help='CNN doubt threshold percentile, default: 85')
    parser.add_argument('--cnn-anomaly-percentile', type=float, default=90,
                        help='CNN anomaly threshold percentile, default: 90')
    
    args = parser.parse_args()
    
    # Parameter validation
    if args.batch_size <= 0:
        parser.error('--batch-size must be > 0')
    if args.epochs <= 0:
        parser.error('--epochs must be > 0')
    if not (0 < args.lr < 1):
        parser.error('--lr must be between 0 and 1')
    if args.cnn_doubt_percentile >= args.cnn_anomaly_percentile:
        parser.error('--cnn-doubt-percentile must be < --cnn-anomaly-percentile')
    if not (0 < args.cnn_doubt_percentile < 100):
        parser.error('--cnn-doubt-percentile must be between 0 and 100')
    if not (0 < args.cnn_anomaly_percentile < 100):
        parser.error('--cnn-anomaly-percentile must be between 0 and 100')
    
    return args

def scan_directory(directory, pattern='*.txt'):
    """Scan directory and get all matching files"""
    if not os.path.exists(directory):
        raise FileNotFoundError(f"Directory not found: {directory}")
    
    if not os.path.isdir(directory):
        raise NotADirectoryError(f"Path is not a directory: {directory}")
    
    search_path = os.path.join(directory, pattern)
    files = sorted(glob.glob(search_path))
    
    if len(files) == 0:
        raise ValueError(f"No matching files found: {search_path}")
    
    print(f"📂 Scanning directory: {directory}")
    print(f"   Pattern: {pattern}")
    print(f"   Found: {len(files)} files")
    if len(files) <= 5:
        for f in files:
            print(f"     - {os.path.basename(f)}")
    else:
        print(f"     - {os.path.basename(files[0])}")
