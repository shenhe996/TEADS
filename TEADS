def read_multiple_files(file_paths, file_type="training"):
    """Read and merge multiple TE distribution files"""
    if isinstance(file_paths, str):
        file_paths = [file_paths]
    
    print(f"\n=== Reading {file_type} data files ===")
    print(f"Files: {[os.path.basename(f) for f in file_paths]}")
    
    all_dataframes = []
    successful_files = []
    failed_files = []
    
    for i, file_path in enumerate(file_paths, 1):
        print(f"\n📁 Reading file {i}/{len(file_paths)}: {os.path.basename(file_path)}")
        
        if not os.path.exists(file_path):
            print(f"   ❌ File not found: {file_path}")
            failed_files.append((file_path, "File not found"))
            continue
        
        file_size = os.path.getsize(file_path)
        if file_size == 0:
            print(f"   ❌ Empty file: {file_path}")
            failed_files.append((file_path, "Empty file"))
            continue
        
        print(f"   📊 File size: {file_size:,} bytes")
        
        # Try different encodings
        read_success = False
        for encoding in ['utf-8', 'gbk', 'latin1', 'cp1252']:
            try:
                print(f"   🔧 Trying encoding: {encoding}")
                df = pd.read_csv(file_path, sep='\t', encoding=encoding)
                
                if len(df) == 0:
                    print(f"   ❌ Empty data")
                    failed_files.append((file_path, "Empty data"))
                    break
                
                df['Source_File'] = os.path.basename(file_path)
                df['Source_Index'] = i
                
                all_dataframes.append(df)
                successful_files.append(file_path)
                read_success = True
                print(f"   ✅ Successfully added")
                break
                
            except UnicodeDecodeError:
                print(f"   ⚠️  Encoding {encoding} failed")
                continue
            except Exception as e:
                print(f"   ❌ Read failed ({encoding}): {e}")
                continue
        
        if not read_success:
            print(f"   ❌ All encodings failed")
            if file_path not in [f[0] for f in failed_files]:
                failed_files.append((file_path, "All encodings failed"))
    
    # Output statistics
    print(f"\n📊 File reading statistics:")
    print(f"   Attempted: {len(file_paths)} files")
    print(f"   Successful: {len(successful_files)} files")
    print(f"   Failed: {len(failed_files)} files")
    
    if successful_files:
        print(f"   ✅ Successful files:")
        for file_path in successful_files:
            print(f"      {os.path.basename(file_path)}")
    
    if failed_files:
        print(f"   ❌ Failed files:")
        for file_path, reason in failed_files:
            print(f"      {os.path.basename(file_path)}: {reason}")
    
    if not all_dataframes:
        raise ValueError(f"No {file_type} files successfully read! Check file format and paths.")
    
    # Merge all data
    combined_df = pd.concat(all_dataframes, ignore_index=True)
    print(f"\n✅ {file_type} data merged:")
    print(f"   Total rows: {len(combined_df)}")
    print(f"   Source files: {len(file_paths)}")
    print(f"   Unique scaffolds: {combined_df['Chr'].nunique()}")
    
    source_stats = combined_df.groupby('Source_File')['Chr'].nunique()
    print("   Scaffold contribution per file:")
    for filename, count in source_stats.items():
        print(f"     {filename}: {count} chromosomes")
    
    return combined_df

def preprocess_data(df, min_windows=15, min_length=10000000, dataset_name=""):
    """Preprocess data and filter scaffolds"""
    df = df[df['Chr'] != 'whole_genome'].copy()
    
    # Fix scaffold naming conflicts
    if 'Source_File' in df.columns:
        print(f"\n=== Fixing scaffold naming conflicts ===")
        print(f"Before: {df['Chr'].nunique()} unique scaffolds")
        
        def add_file_prefix(row):
            filename = row['Source_File']
            base_name = os.path.splitext(filename)[0]
            
            if '_' in base_name:
                prefix = base_name.split('_')[0]
            elif '.' in base_name:
                prefix = base_name.split('.')[0]
            else:
                prefix = base_name[:10]
            
            return f"{prefix}_{row['Chr']}"
        
        df['Chr'] = df.apply(add_file_prefix, axis=1)
        print(f"After: {df['Chr'].nunique()} unique scaffolds")
    
    df['Window_Length'] = df['To'] - df['From']
    
    print(f"\n=== {dataset_name} data preprocessing ===")
    print(f"Total rows: {len(df)}")
    print(f"Unique scaffolds: {df['Chr'].nunique()}")
    
    scaffolds = {}
    filtered_scaffolds = []
    
    for name, group in df.groupby('Chr'):
        group = group.sort_values('From').reset_index(drop=True)
        scaffold_length = group['To'].max()
        num_windows = len(group)
        
        if num_windows < min_windows or scaffold_length < min_length:
            filtered_scaffolds.append({
                'name': name,
                'windows': num_windows,
                'length': scaffold_length,
                'source': group['Source_File'].iloc[0] if 'Source_File' in group.columns else 'unknown'
            })
            continue
            
        scaffolds[name] = {
            'positions': group['From'].values,
            'end_positions': group['To'].values,
            'total_length': scaffold_length,
            'values': group['TE'].values,
            'window_lengths': group['Window_Length'].values,
            'num_windows': num_windows,
            'ltr': group['LTR'].values,
            'line': group['LINE'].values,
            'sine': group['SINE'].values,
            'dna': group['DNA'].values,
            'unknown': group['unknown'].values,
            'source_file': group['Source_File'].iloc[0] if 'Source_File' in group.columns else 'unknown'
        }
    
    print(f"\nFiltering statistics:")
    print(f"  Filtered out: {len(filtered_scaffolds)} scaffolds")
    if filtered_scaffolds:
        filtered_by_source = defaultdict(list)
        for item in filtered_scaffolds:
            filtered_by_source[item['source']].append(item)
        
        for source, items in filtered_by_source.items():
            print(f"    From {source}: {len(items)} scaffolds")
            for item in items[:3]:
                print(f"      {item['name']}: {item['windows']} windows, {item['length']:,} bp")
            if len(items) > 3:
                print(f"      ... and {len(items) - 3} more")
    
    print(f"  Retained: {len(scaffolds)} scaffolds")
    
    if scaffolds:
        source_counts = Counter([data['source_file'] for data in scaffolds.values()])
        print("  Retained scaffold distribution:")
        for source, count in source_counts.items():
            print(f"    {source}: {count} scaffolds")
    
    return scaffolds

def prepare_complete_scaffolds(scaffolds, max_length=100):
    """Process scaffolds, standardize to length 100"""
    sequences = []
    names = []
    for name, data in scaffolds.items():
        values = data['values']
        
        if len(values) != max_length:
            print(f"Warning: {name} has length {len(values)}, expected {max_length}")
        
        sequences.append(values)
        names.append(name)
    
    return sequences, names

