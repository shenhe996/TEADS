            print(f"\nTotal test scaffolds: {len(results['scaffold_names'])}")
            print(f"Detected anomalies: {results['num_anomaly']}")
            print(f"Anomaly rate: {results['anomaly_rate']:.2%}")
            
            visualize_classification_results(test_scaffolds, results, max_plots=5000)
            output_path, results_df = save_results(results, test_scaffolds)
            
            anomalies = results_df[results_df['Final_Status'] == 'anomaly']
            if len(anomalies) > 0:
                print(f"\n📋 Anomalous scaffold details:")
                print("=" * 80)
                for i, (_, row) in enumerate(anomalies.iterrows(), 1):
                    print(f"{i:2d}. {row['Scaffold']} (source: {row.get('Source_File', 'unknown')})")
                    print(f"    CNN score: {row['CNN_Score']:.4f}")
                    print(f"    Pattern score: {row['Pattern_Score']:.4f}")
                    print(f"    Pattern type: {row['Pattern_Type']}")
                    print(f"    Reason: {row['Reason']}")
                    print(f"    Has outliers: {'Yes' if row['Has_Outliers'] else 'No'}")
                    print()
            
            print("🎉 TE anomaly detection pipeline completed!")
            print(f"📁 Results file: {output_path}")
            
            return results, model, test_scaffolds
        
        else:
            print(f"❌ Error: Unknown mode '{mode}'")
            return None, None, None
            
    except Exception as e:
        print(f"❌ Error: {str(e)}")
        import traceback
        traceback.print_exc()
        return None, None, None

def main():
    """Interactive entry function"""
    args = parse_arguments()
    
    print("\n" + "="*60)
    print("🧬 TE Transposon Anomaly Detection System")
    print("="*60)
    
    if args.mode:
        mode = args.mode
        print(f"\n▶️  Running mode: {mode}")
    else:
        print("\n📋 Select running mode:")
